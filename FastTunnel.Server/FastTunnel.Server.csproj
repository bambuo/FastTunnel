<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>default</LangVersion>
    <!-- 覆盖 Directory.Build.props 的全局设置：Server 的本地化中间件需要完整 globalization -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 静态文件以嵌入资源提供（EmbedAdminDist），不使用 Static Web Assets 构建目标 -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <!-- 前端 dist 嵌入为资源清单，供 ManifestEmbeddedFileProvider 读取 -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="logs\**" />
    <Content Remove="logs\**" />
    <EmbeddedResource Remove="logs\**" />
    <None Remove="logs\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0-preview.3.25171.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
  </ItemGroup>

  <!--<ItemGroup Condition="'$(Configuration)'=='Debug'">
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="6.5.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="6.5.0" />
  </ItemGroup>-->

  <ItemGroup>
    <ProjectReference Include="..\FastTunnel.Core\FastTunnel.Core.csproj" />
    <ProjectReference Include="..\FastTunnel.Api\FastTunnel.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 开发环境配置不随发布分发 -->
    <Content Update="appsettings.Development.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <None Update="uninstall.bat">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="install.bat">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 前端构建产物（FastTunnel.Admin/dist）嵌入为 wwwroot/ 前缀的资源，
       单文件发布后静态文件随二进制分发；dist 缺失时自动执行 bun 构建。
       时机须早于 FileProviders.Embedded 包的 _CalculateEmbeddedFilesManifestInputs
       （PrepareResourceNames 的依赖），否则嵌入清单不会被编译进程序集 -->
  <Target Name="EmbedAdminDist" BeforeTargets="PrepareForBuild">    <Exec Condition="!Exists('..\FastTunnel.Admin\dist\index.html')" Command="bun install" WorkingDirectory="..\FastTunnel.Admin" ContinueOnError="true" />
    <Exec Condition="!Exists('..\FastTunnel.Admin\dist\index.html')" Command="bun run build" WorkingDirectory="..\FastTunnel.Admin" ContinueOnError="true" />
    <ItemGroup>
      <EmbeddedResource Remove="..\FastTunnel.Admin\dist\**\*" />
      <EmbeddedResource Include="..\FastTunnel.Admin\dist\**\*" />
    </ItemGroup>
    <ItemGroup>
      <EmbeddedResource Update="..\FastTunnel.Admin\dist\**\*">
        <LogicalName>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <!-- 依赖库（FastTunnel.Core 为 NuGet 包生成）的文档 xml 不进发布目录：单文件运行不需要 -->
  <Target Name="RemoveDependencyDocsFromPublish" AfterTargets="CopyFilesToPublishDirectory">
    <Delete Files="$(PublishDir)FastTunnel.Core.xml" />
  </Target>

  <ProjectExtensions>
    <VisualStudio>
      <UserProperties config_4appsettings_1development_1json__JsonSchema="https://json.schemastore.org/appsettings.json" />
    </VisualStudio>
  </ProjectExtensions>
</Project>
