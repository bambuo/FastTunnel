<!-- Centralized build settings for the solution. Edit <TargetFramework> to change the unified .NET version. -->
<Project>
  <PropertyGroup>
    <!-- Unified target framework for all projects in the repository -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- Common defaults mirrored from several projects; adjust if needed -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Release 发布不生成调试符号（pdb 不随发布产物分发） -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
